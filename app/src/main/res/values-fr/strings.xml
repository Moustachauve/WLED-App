    <!-- Sound Sync -->
    <string name="sound_sync">Synchro Sonore</string>
    <string name="sound_sync_description">Envoyez des données réactives à l\'audio vers vos appareils WLED avec la synchronisation sonore UDP. Les appareils doivent être en mode Réception dans leurs paramètres de synchronisation audio.</string>
    <string name="sound_sync_gain">Gain</string>
    <string name="sound_sync_gain_value">%1$.1fx</string>
    <string name="sound_sync_agc">Contrôle Automatique du Gain</string>
    <string name="sound_sync_agc_description">Ajuste automatiquement le gain selon le volume ambiant</string>
    <string name="sound_sync_agc_mode_normal">Normal</string>
    <string name="sound_sync_agc_mode_vivid">Vif</string>
    <string name="sound_sync_agc_mode_lazy">Lent</string>
    <string name="sound_sync_agc_mode_normal_description">Suit en douceur les changements de volume. Un bon choix par défaut.</string>
    <string name="sound_sync_agc_mode_vivid_description">Réagit rapidement aux changements de volume pour une réponse plus marquée.</string>
    <string name="sound_sync_agc_mode_lazy_description">S\'ajuste plus lentement. Idéal pour les effets GEQ ou la musique à large plage dynamique.</string>
    <string name="sound_sync_squelch">Squelch (seuil de bruit)</string>
    <string name="sound_sync_squelch_decrease">Réduire le seuil de bruit</string>
    <string name="sound_sync_squelch_increase">Augmenter le seuil de bruit</string>
    <string name="sound_sync_squelch_description">Ignore le bruit de fond sous ce seuil lorsqu\'aucune musique ne joue.</string>
    <string name="sound_sync_port">Port UDP</string>
    <string name="sound_sync_port_description">Port UDP utilisé pour envoyer les données audio. Doit correspondre au port défini dans les paramètres de synchronisation audio de vos appareils WLED (par défaut : 11988).</string>
    <string name="sound_sync_port_error">Entrez un port valide entre 1 et 65535</string>
    <string name="sound_sync_send_mode">Mode de transmission</string>
    <string name="sound_sync_send_mode_unicast">Unicast</string>
    <string name="sound_sync_send_mode_multicast">Multicast</string>
    <string name="sound_sync_send_mode_unicast_description">Envoie les données audio directement à chaque appareil WLED en ligne sélectionné. Fonctionne de manière fiable sur la plupart des réseaux Wi-Fi et VLAN.</string>
    <string name="sound_sync_send_mode_multicast_description">Envoie un seul flux multicast (239.0.0.1) à tous les appareils WLED sur le même réseau. Idéal pour les grandes installations si votre routeur prend en charge le multicast.</string>
