    "beta_migration_card_warning" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Updating to the beta version moves your controller to the new Illumidel app. This action cannot be undone and this app will no longer work with this controller."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention : La mise à jour vers la version bêta fait passer votre contrôleur à la nouvelle application Illumidel. Cette action est irréversible et cette application ne fonctionnera plus avec ce contrôleur."
          }
        }
      }
    },
